ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=v1.0
HTTP_PORT=80

APP_NAME=Integrated Weather & Course WAS
ENVIRONMENT=production
DATA_MODE=database
WEATHER_MODE=database
WEATHER_STORAGE=database
WEATHER_DATABASE_BATCH_SIZE=1000
WEATHER_SNAPSHOT_RETENTION=3

DB_PRIVATE_HOST=10.0.20.10
DB_NAME=integrated
DB_USER=app
DB_PASSWORD=replace-with-db-password
WRITE_DATABASE_URL=mysql+asyncmy://app:replace-with-db-password@10.0.20.10:3306/integrated
READ_DATABASE_URL=mysql+asyncmy://app:replace-with-db-password@10.0.20.10:3306/integrated

REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
CORS_ORIGINS=http://replace-with-domain-or-elastic-ip
CORS_ORIGIN_REGEX=
COOKIE_SECURE=false

KMA_SERVICE_KEY=
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=5
KMA_COLLECTION_CONCURRENCY=5
KMA_COURSE_LIMIT=0
