ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=v1.0
WAS_PORT=8000

APP_NAME=Integrated Weather & Course WAS
ENVIRONMENT=production
DATA_MODE=database
WEATHER_MODE=database
WEATHER_STORAGE=database
WEATHER_DATABASE_BATCH_SIZE=1000
WEATHER_SNAPSHOT_RETENTION=3

DB_HOST=10.0.20.10
DB_PORT=3306
DB_NAME=integrated
DB_USER=app
WRITE_DATABASE_URL=mysql+asyncmy://app:<from-ssm>@10.0.20.10:3306/integrated
READ_DATABASE_URL=mysql+asyncmy://app:<from-ssm>@10.0.20.10:3306/integrated

REDIS_URL=redis://redis:6379/0
JWT_SECRET=<from-ssm>
ACCOUNT_PROVIDER=local
# 관리자 권한은 users.role=ADMIN 기준입니다. Cognito 모드에서도 로컬 users 매핑 role을 사용합니다.
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<from-ssm>
CORS_ORIGINS=https://replace-with-cloudfront-domain
CORS_ORIGIN_REGEX=
COOKIE_SECURE=true

KMA_SERVICE_KEY=
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=5
KMA_COLLECTION_CONCURRENCY=5
KMA_COURSE_LIMIT=0
