# was-vm의 사설 IP. 모든 인터페이스에 바인딩하려면 0.0.0.0
WAS_BIND_IP=10.0.2.10

APP_NAME=Integrated Weather & Course WAS
ENVIRONMENT=production
DATA_MODE=database
WEATHER_MODE=database
WEATHER_STORAGE=database
WEATHER_DATABASE_BATCH_SIZE=1000
WEATHER_SNAPSHOT_RETENTION=3

# db-vm의 사설 IP 또는 내부 DNS로 변경
WRITE_DATABASE_URL=mysql+asyncmy://app:change-me@10.0.3.10:3306/integrated
READ_DATABASE_URL=mysql+asyncmy://app:change-me@10.0.3.10:3306/integrated

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# web-vm에 실제로 접속할 주소
CORS_ORIGINS=http://10.0.1.10
CORS_ORIGIN_REGEX=
COOKIE_SECURE=false
KMA_SERVICE_KEY=
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=5
KMA_COLLECTION_CONCURRENCY=10
KMA_COURSE_LIMIT=0
