# app-vm 또는 app-ec2에서 외부에 공개할 HTTP 주소입니다.
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80

APP_NAME=Integrated Weather & Course WAS
ENVIRONMENT=production
DATA_MODE=database
WEATHER_MODE=database
WEATHER_STORAGE=database
WEATHER_DATABASE_BATCH_SIZE=1000
WEATHER_SNAPSHOT_RETENTION=3

# 초기 단일 MariaDB는 DB_HOST에 DB VM/EC2 사설 IP를 넣습니다.
# AWS Galera 전환 후에는 HAProxy, MaxScale, 내부 DNS 등의 endpoint로 바꿉니다.
DB_HOST=10.0.3.10
DB_PORT=3306
DB_NAME=integrated
DB_USER=app
DB_PASSWORD=change-me
WRITE_DATABASE_URL=mysql+asyncmy://app:change-me@10.0.3.10:3306/integrated
READ_DATABASE_URL=mysql+asyncmy://app:change-me@10.0.3.10:3306/integrated

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 실제 서비스 접속 주소입니다. 도메인을 쓰면 https://example.com 형태로 변경합니다.
PUBLIC_ORIGIN=http://10.0.1.10
CORS_ORIGINS=http://10.0.1.10
CORS_ORIGIN_REGEX=
COOKIE_SECURE=false

KMA_SERVICE_KEY=
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=5
KMA_COLLECTION_CONCURRENCY=10
KMA_COURSE_LIMIT=0
