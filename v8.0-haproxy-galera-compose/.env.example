COMPOSE_PROJECT_NAME=haproxy-galera
MARIADB_DATABASE=appdb
MARIADB_USER=appuser

# WAS connects to this host port. It is forwarded to the HAProxy container.
HAPROXY_BIND_IP=0.0.0.0
HAPROXY_STATS_BIND_IP=127.0.0.1

# Direct DB ports are for administrator diagnostics only.
DB_DIRECT_BIND_IP=127.0.0.1

# Set to 1 only while bootstrapping db1 for a new cluster.
GALERA_BOOTSTRAP_NODE1=0
