# =============================================================================
# Integrated WAS 환경 변수 예시
# =============================================================================
# 사용 방법:
#   1. 이 파일을 복사해 같은 위치에 `.env` 파일을 만듭니다.
#      cp .env.example .env
#   2. 로컬 개발 단계에서는 기본값인 DATA_MODE=mock을 사용합니다.
#   3. DB가 확정되면 DATA_MODE=database로 바꾸고 Writer/Reader 주소를 입력합니다.
#
# 주의:
#   - 실제 비밀번호, JWT 비밀키, 공공 API 인증키는 이 파일에 저장하지 않습니다.
#   - `.env`는 Git에 커밋하지 않습니다.

# -----------------------------------------------------------------------------
# 애플리케이션 기본 설정
# -----------------------------------------------------------------------------

# Swagger 문서와 서버 상태 응답 등에 표시되는 서비스 이름입니다.
APP_NAME=Integrated Weather & Course WAS

# 실행 환경 구분값입니다. 예: local, development, staging, production
ENVIRONMENT=local

# 모든 비즈니스 API 앞에 붙는 공통 경로입니다.
# 예: /api/courses, /api/reservations
API_PREFIX=/api

# -----------------------------------------------------------------------------
# 데이터 제공 모드
# -----------------------------------------------------------------------------

# mock:
#   DB, Redis, 기상청 인증키 없이 app/data/mock_data.json을 사용합니다.
#   예약 변경 내용은 프로세스 메모리에만 저장되고 서버 재시작 시 초기화됩니다.
#
# database:
#   Command는 WRITE_DATABASE_URL, Query는 READ_DATABASE_URL을 사용합니다.
DATA_MODE=mock

# 날씨 데이터 제공 방식은 DB 모드와 독립적으로 선택합니다.
#
# mock:
#   app/data/mock_data.json의 고정 샘플을 사용합니다.
#
# snapshot:
#   크론 수집기가 만든 KMA_SNAPSHOT_PATH 파일을 읽습니다.
#   사용자 API 요청 시 기상청을 호출하지 않으므로 현재 권장 방식입니다.
#
# live:
#   사용자 API 요청 시 기상청 API를 호출하고 Redis/메모리에 캐시합니다.
WEATHER_MODE=mock

# 정기 수집 결과 저장소입니다.
#
# json:
#   KMA_SNAPSHOT_PATH의 JSON 파일을 원자적으로 교체합니다.
#
# database:
#   Writer DB에 COLLECTING 스냅샷을 만들고 예보를 배치 저장한 뒤
#   검증이 완료된 스냅샷만 ACTIVE로 전환합니다.
WEATHER_STORAGE=json

# MariaDB에 예보를 저장할 때 한 번에 전달하는 행 수입니다.
WEATHER_DATABASE_BATCH_SIZE=1000

# ACTIVE 이전 스냅샷 중 보관할 ARCHIVED 스냅샷 개수입니다.
WEATHER_SNAPSHOT_RETENTION=3

# -----------------------------------------------------------------------------
# 데이터베이스 설정
# -----------------------------------------------------------------------------
# DATA_MODE=mock에서는 아래 DB 주소를 사용하지 않습니다.
#
# SQLite 단일 DB 예시:
#   sqlite+aiosqlite:///./integrated_was.db
#
# MariaDB/MySQL Master-Replica 예시:
#   WRITE_DATABASE_URL=mysql+asyncmy://app:password@db-master:3306/integrated
#   READ_DATABASE_URL=mysql+asyncmy://app:password@db-replica:3306/integrated

# POST, DELETE, 로그인 등 상태 변경 작업이 사용하는 Writer/Master DB입니다.
WRITE_DATABASE_URL=sqlite+aiosqlite:///./integrated_was.db

# GET 조회 작업이 사용하는 Reader/Replica DB입니다.
# DB 복제가 구성되지 않은 개발 환경에서는 Writer와 같은 주소를 사용해도 됩니다.
READ_DATABASE_URL=sqlite+aiosqlite:///./integrated_was.db

# -----------------------------------------------------------------------------
# Redis 캐시
# -----------------------------------------------------------------------------
# WEATHER_MODE=live 또는 정기 수집 작업에서 API 응답 캐시에 사용합니다.
# Docker Compose 내부에서는 redis://redis:6379/0을 사용합니다.
# Redis 연결 실패 시 애플리케이션 내부 TTL 캐시로 임시 전환됩니다.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT 및 인증 쿠키
# -----------------------------------------------------------------------------

# JWT 서명에 사용하는 비밀키입니다.
# 운영 환경에서는 충분히 긴 무작위 문자열로 반드시 교체해야 합니다.
JWT_SECRET=change-this-secret-in-production

# JWT 서명 알고리즘입니다. 특별한 요구사항이 없다면 HS256을 유지합니다.
JWT_ALGORITHM=HS256

# 로그인 토큰 유효 시간이며 단위는 분입니다.
JWT_EXPIRE_MINUTES=60

# 계정 관리 provider입니다. local은 users 테이블, cognito는 AWS Cognito User Pool을 사용합니다.
ACCOUNT_PROVIDER=local
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DATA_MODE=mock에서 DB 없이 사용하는 데모 로그인 계정입니다.
DEMO_USERNAME=admin
DEMO_PASSWORD=password123

# 관리자 전용 로그인 API에서 허용할 계정명입니다.
# 운영에서는 DB에 동일한 계정을 안전한 비밀번호로 생성해야 합니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# true이면 HTTPS 연결에서만 인증 쿠키가 전송됩니다.
# 로컬 HTTP 개발은 false, HTTPS 운영 환경은 true를 권장합니다.
COOKIE_SECURE=false

# 브라우저에서 쿠키 인증 API를 호출할 수 있는 프론트엔드 출처입니다.
# 여러 주소는 쉼표로 구분합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 로컬 개발 시 사설망 IP의 Vite 서버(:5173) 접속을 허용합니다.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(\.[0-9]{1,3}){3}|192\.168(\.[0-9]{1,3}){2}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2}):(5173|5174)$

# -----------------------------------------------------------------------------
# 기상청 공공 API
# -----------------------------------------------------------------------------
# DATA_MODE=mock에서는 아래 인증키와 API 주소를 사용하지 않습니다.

# 공공데이터포털에서 발급받은 기상청 API 서비스 키입니다.
# 실제 키는 `.env`에만 입력하고 Git에 커밋하지 않습니다.
# 반드시 공공데이터포털의 Decoding 인증키를 입력합니다.
# httpx가 요청 파라미터를 URL 인코딩하므로 Encoding 키를 넣으면 인증에 실패합니다.
KMA_SERVICE_KEY=

# 기상청 관광코스별 관광기상정보 조회 서비스 기본 주소입니다.
KMA_BASE_URL=https://apis.data.go.kr/1360000/TourStnInfoService1

# 사용하는 첫 번째 API:
#   getTourStnVilageFcst1 - 관광코스별 동네예보
#
# 사용하는 두 번째 API:
#   getCityTourClmIdx1 - 시군구별 관광기후지수
#
# 두 API는 같은 KMA_BASE_URL과 KMA_SERVICE_KEY를 공유하고 operation 경로만
# 다르므로 별도의 URL/인증키 환경 변수로 나누지 않습니다.

# 기상청 API 요청 제한 시간이며 단위는 초입니다.
KMA_TIMEOUT_SECONDS=5

# 크론 수집 결과를 저장할 JSON 파일입니다.
# WAS와 수집 작업이 같은 경로를 바라봐야 합니다.
KMA_SNAPSHOT_PATH=./data/kma_snapshot.json

# 타임아웃, 요청 제한, KMA 서버 오류 등 일시적 실패의 재시도 설정입니다.
# 404 데이터 없음은 재시도하지 않습니다.
# 재시도 간격은 아래 값을 기준으로 5초, 10초처럼 증가합니다.
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=5

# 전체 434개 코스를 동시에 호출하지 않도록 최대 동시 요청 수를 제한합니다.
KMA_COLLECTION_CONCURRENCY=10

# 0이면 전체 코스, 양수이면 앞에서부터 지정한 개수만 수집합니다.
# 개발 중에는 5~10으로 API 호출량을 제한할 수 있습니다.
KMA_COURSE_LIMIT=0
# =============================================================================
# Integrated WAS 환경 변수 예시
# =============================================================================
# 사용 방법:
#   1. 이 파일을 복사해 같은 위치에 `.env` 파일을 만듭니다.
#      cp .env.example .env
#   2. 로컬 개발 단계에서는 기본값인 DATA_MODE=mock을 사용합니다.
#   3. DB가 확정되면 DATA_MODE=database로 바꾸고 Writer/Reader 주소를 입력합니다.
#
# 주의:
#   - 실제 비밀번호, JWT 비밀키, 공공 API 인증키는 이 파일에 저장하지 않습니다.
#   - `.env`는 Git에 커밋하지 않습니다.

# -----------------------------------------------------------------------------
# 애플리케이션 기본 설정
# -----------------------------------------------------------------------------

# Swagger 문서와 서버 상태 응답 등에 표시되는 서비스 이름입니다.
APP_NAME=Integrated Weather & Course WAS

# 실행 환경 구분값입니다. 예: local, development, staging, production
ENVIRONMENT=local

# 모든 비즈니스 API 앞에 붙는 공통 경로입니다.
# 예: /api/courses, /api/reservations
API_PREFIX=/api

# -----------------------------------------------------------------------------
# 데이터 제공 모드
# -----------------------------------------------------------------------------

# mock:
#   DB, Redis, 기상청 인증키 없이 app/data/mock_data.json을 사용합니다.
#   예약 변경 내용은 프로세스 메모리에만 저장되고 서버 재시작 시 초기화됩니다.
#
# database:
#   Command는 WRITE_DATABASE_URL, Query는 READ_DATABASE_URL을 사용합니다.
DATA_MODE=mock

# 날씨 데이터 제공 방식은 DB 모드와 독립적으로 선택합니다.
#
# mock:
#   app/data/mock_data.json의 고정 샘플을 사용합니다.
#
# snapshot:
#   크론 수집기가 만든 KMA_SNAPSHOT_PATH 파일을 읽습니다.
#   사용자 API 요청 시 기상청을 호출하지 않으므로 현재 권장 방식입니다.
#
# live:
#   사용자 API 요청 시 기상청 API를 호출하고 Redis/메모리에 캐시합니다.
WEATHER_MODE=mock

# -----------------------------------------------------------------------------
# 데이터베이스 설정
# -----------------------------------------------------------------------------
# DATA_MODE=mock에서는 아래 DB 주소를 사용하지 않습니다.
#
# SQLite 단일 DB 예시:
#   sqlite+aiosqlite:///./integrated_was.db
#
# MariaDB/MySQL Master-Replica 예시:
#   WRITE_DATABASE_URL=mysql+asyncmy://app:password@db-master:3306/integrated
#   READ_DATABASE_URL=mysql+asyncmy://app:password@db-replica:3306/integrated

# POST, DELETE, 로그인 등 상태 변경 작업이 사용하는 Writer/Master DB입니다.
WRITE_DATABASE_URL=sqlite+aiosqlite:///./integrated_was.db

# GET 조회 작업이 사용하는 Reader/Replica DB입니다.
# DB 복제가 구성되지 않은 개발 환경에서는 Writer와 같은 주소를 사용해도 됩니다.
READ_DATABASE_URL=sqlite+aiosqlite:///./integrated_was.db

# -----------------------------------------------------------------------------
# Redis 캐시
# -----------------------------------------------------------------------------
# WEATHER_MODE=live 또는 정기 수집 작업에서 API 응답 캐시에 사용합니다.
# Docker Compose 내부에서는 redis://redis:6379/0을 사용합니다.
# Redis 연결 실패 시 애플리케이션 내부 TTL 캐시로 임시 전환됩니다.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT 및 인증 쿠키
# -----------------------------------------------------------------------------

# JWT 서명에 사용하는 비밀키입니다.
# 운영 환경에서는 충분히 긴 무작위 문자열로 반드시 교체해야 합니다.
JWT_SECRET=change-this-secret-in-production

# JWT 서명 알고리즘입니다. 특별한 요구사항이 없다면 HS256을 유지합니다.
JWT_ALGORITHM=HS256

# 로그인 토큰 유효 시간이며 단위는 분입니다.
JWT_EXPIRE_MINUTES=60

# true이면 HTTPS 연결에서만 인증 쿠키가 전송됩니다.
# 로컬 HTTP 개발은 false, HTTPS 운영 환경은 true를 권장합니다.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# 기상청 공공 API
# -----------------------------------------------------------------------------
# DATA_MODE=mock에서는 아래 인증키와 API 주소를 사용하지 않습니다.

# 공공데이터포털에서 발급받은 기상청 API 서비스 키입니다.
# 실제 키는 `.env`에만 입력하고 Git에 커밋하지 않습니다.
# 반드시 공공데이터포털의 Decoding 인증키를 입력합니다.
# httpx가 요청 파라미터를 URL 인코딩하므로 Encoding 키를 넣으면 인증에 실패합니다.
KMA_SERVICE_KEY=

# 기상청 관광코스별 관광기상정보 조회 서비스 기본 주소입니다.
KMA_BASE_URL=https://apis.data.go.kr/1360000/TourStnInfoService1

# 사용하는 첫 번째 API:
#   getTourStnVilageFcst1 - 관광코스별 동네예보
#
# 사용하는 두 번째 API:
#   getCityTourClmIdx1 - 시군구별 관광기후지수
#
# 두 API는 같은 KMA_BASE_URL과 KMA_SERVICE_KEY를 공유하고 operation 경로만
# 다르므로 별도의 URL/인증키 환경 변수로 나누지 않습니다.

# 기상청 API 요청 제한 시간이며 단위는 초입니다.
KMA_TIMEOUT_SECONDS=5

# 크론 수집 결과를 저장할 JSON 파일입니다.
# WAS와 수집 작업이 같은 경로를 바라봐야 합니다.
KMA_SNAPSHOT_PATH=./data/kma_snapshot.json

# 발표 직후 데이터가 늦게 제공되거나 통신이 실패할 때의 재시도 설정입니다.
KMA_COLLECTION_RETRIES=3
KMA_COLLECTION_RETRY_SECONDS=60

# 전체 434개 코스를 동시에 호출하지 않도록 최대 동시 요청 수를 제한합니다.
KMA_COLLECTION_CONCURRENCY=10

# 0이면 전체 코스, 양수이면 앞에서부터 지정한 개수만 수집합니다.
# 개발 중에는 5~10으로 API 호출량을 제한할 수 있습니다.
KMA_COURSE_LIMIT=0
