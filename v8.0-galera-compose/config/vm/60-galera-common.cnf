[mariadbd]
bind-address=0.0.0.0
skip-name-resolve

# Galera common settings. Node-specific values are supplied by compose.vm.yaml.
default_storage_engine=InnoDB
binlog_format=ROW
innodb_autoinc_lock_mode=2
innodb_flush_log_at_trx_commit=1
wsrep_on=ON
wsrep_provider=/usr/lib/galera/libgalera_smm.so
wsrep_cluster_name=three-tier-galera
wsrep_sst_method=mariabackup

# Listen on the container/host network and advertise the VM IP from wsrep_node_address.
wsrep_provider_options="gmcast.listen_addr=tcp://0.0.0.0:4567;gcache.size=512M;gcache.recover=yes"

character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
max_connections=300
